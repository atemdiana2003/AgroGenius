generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  FARMER
  BUYER
  ADMIN
}

enum Unit {
  KG
  CRATE
  PIECE
}

enum BatchStatus {
  STORED
  LISTED
  PARTIALLY_SOLD
  SOLD
  SPOILED
  ARCHIVED
}

enum StorageMethod {
  COOLER
  SHADED_CONTROL
  OTHER
}

enum TrialGroupType {
  COOLER_TEST
  SHADED_CONTROL
}

enum ReadingSource {
  MANUAL
  SENSOR
  SIMULATED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ListingStatus {
  ACTIVE
  RESERVED
  PARTIALLY_SOLD
  SOLD
  EXPIRED
  HIDDEN
}

enum AlertCondition {
  AT_OR_ABOVE
  AT_OR_BELOW
}

enum NotificationEvent {
  TARGET_PRICE_REACHED
  STORAGE_WARNING
  BUYER_OFFER
  LISTING_EXPIRING
  CONTACT_REQUEST
}

enum NotificationChannel {
  IN_APP
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  SIMULATED
  FAILED
  READ
}

enum SyncStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  CONFLICT
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum MovementReason {
  LISTING_RESERVE
  SALE
  SPOILAGE
  ADJUSTMENT
  RELEASE
}

enum ContactRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESSFUL
  FAILED
  EXPIRED
  INITIATION_UNKNOWN
}

enum PaymentMode {
  SANDBOX
  LIVE
  SIMULATED
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  displayName        String               @db.VarChar(120)
  phone              String?              @unique @db.VarChar(32)
  email              String?              @unique @db.VarChar(254)
  passwordHash       String
  role               Role                 @default(FARMER)
  community          String               @db.VarChar(120)
  preferredLanguage  String               @default("en") @db.VarChar(12)
  cooperative        String?              @db.VarChar(160)
  smsConsent         Boolean              @default(false)
  smsOptOut          Boolean              @default(false)
  quietHoursStart    String?              @db.VarChar(5)
  quietHoursEnd      String?              @db.VarChar(5)
  active             Boolean              @default(true)
  version            Int                  @default(1)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)
  farms              Farm[]
  batches            HarvestBatch[]       @relation("BatchOwner")
  readings           SensorReading[]      @relation("ReadingActor")
  observations       QualityObservation[]
  enteredPrices      PriceObservation[]   @relation("PriceEnteredBy")
  alertRules         PriceAlertRule[]
  listings           ProduceListing[]     @relation("ListingOwner")
  offers             BuyerOffer[]         @relation("OfferBuyer")
  inventoryMovements InventoryMovement[]  @relation("MovementActor")
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  resetTokens        PasswordResetToken[]
  devices            DeviceCredential[]
  syncOperations     SyncOperation[]
  reports            UserReport[]         @relation("ReportAuthor")
  moderationActions  UserReport[]         @relation("ReportModerator")
  auditEvents        AuditLog[]
  contactRequests    ContactRequest[]     @relation("ContactRequester")
  payments           PaymentIntent[]
  PriceObservation   PriceObservation[]

  @@index([role, active])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Farm {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  name      String   @db.VarChar(160)
  community String   @db.VarChar(120)
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  active    Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, active, name])
}

model UnitReference {
  code        Unit     @id
  label       String   @db.VarChar(80)
  description String?  @db.VarChar(240)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
}

model Crop {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @unique @db.VarChar(100)
  validatedForTrial Boolean            @default(false)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  batches           HarvestBatch[]
  prices            PriceObservation[]
  alertRules        PriceAlertRule[]
}

model Market {
  id         String             @id @default(uuid()) @db.Uuid
  name       String             @db.VarChar(160)
  community  String             @db.VarChar(120)
  region     String             @db.VarChar(120)
  active     Boolean            @default(true)
  isDemo     Boolean            @default(false)
  createdAt  DateTime           @default(now()) @db.Timestamptz(6)
  prices     PriceObservation[]
  alertRules PriceAlertRule[]

  @@unique([name, community, region])
}

model StorageUnit {
  id        String          @id @default(uuid()) @db.Uuid
  ownerId   String?         @db.Uuid
  label     String          @db.VarChar(120)
  method    StorageMethod
  community String          @db.VarChar(120)
  isDemo    Boolean         @default(false)
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  sensors   Sensor[]
  batches   HarvestBatch[]
  readings  SensorReading[]
}

model PreservationTrial {
  id              String       @id @default(uuid()) @db.Uuid
  label           String       @db.VarChar(120)
  startedAt       DateTime     @db.Timestamptz(6)
  endedAt         DateTime?    @db.Timestamptz(6)
  protocolNotes   String?
  limitationNotes String?
  isDemo          Boolean      @default(false)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  groups          TrialGroup[]

  @@index([startedAt, endedAt])
}

model Sensor {
  id               String            @id @default(uuid()) @db.Uuid
  storageUnitId    String            @db.Uuid
  identity         String            @unique @db.VarChar(160)
  sensorType       String            @db.VarChar(100)
  unit             String            @default("Celsius and percent RH") @db.VarChar(80)
  calibrationNotes String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  storageUnit      StorageUnit       @relation(fields: [storageUnitId], references: [id], onDelete: Cascade)
  readings         SensorReading[]
  device           DeviceCredential?
}

model DeviceCredential {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  sensorId   String?   @unique @db.Uuid
  tokenHash  String    @unique
  label      String    @db.VarChar(120)
  active     Boolean   @default(true)
  lastUsedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sensor     Sensor?   @relation(fields: [sensorId], references: [id], onDelete: SetNull)
}

model TrialGroup {
  id          String            @id @default(uuid()) @db.Uuid
  trialId     String            @db.Uuid
  label       String            @db.VarChar(120)
  type        TrialGroupType
  initialMass Decimal           @db.Decimal(12, 3)
  unit        Unit              @default(KG)
  notes       String?
  trial       PreservationTrial @relation(fields: [trialId], references: [id], onDelete: Cascade)
  batches     HarvestBatch[]

  @@unique([trialId, type])
}

model HarvestBatch {
  id                String               @id @default(uuid()) @db.Uuid
  ownerId           String               @db.Uuid
  cropId            String               @db.Uuid
  storageUnitId     String?              @db.Uuid
  trialGroupId      String?              @db.Uuid
  variety           String?              @db.VarChar(100)
  harvestAt         DateTime             @db.Timestamptz(6)
  initialQuantity   Decimal              @db.Decimal(12, 3)
  remainingQuantity Decimal              @db.Decimal(12, 3)
  unit              Unit
  status            BatchStatus          @default(STORED)
  storageMethod     StorageMethod
  community         String               @db.VarChar(120)
  notes             String?
  baselineCondition String?
  version           Int                  @default(1)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)
  owner             User                 @relation("BatchOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  crop              Crop                 @relation(fields: [cropId], references: [id], onDelete: Restrict)
  storageUnit       StorageUnit?         @relation(fields: [storageUnitId], references: [id], onDelete: SetNull)
  trialGroup        TrialGroup?          @relation(fields: [trialGroupId], references: [id], onDelete: SetNull)
  movements         InventoryMovement[]
  readings          SensorReading[]
  observations      QualityObservation[]
  listings          ProduceListing[]

  @@index([ownerId, status, harvestAt])
  @@index([cropId, harvestAt])
}

model InventoryMovement {
  id               String          @id @default(uuid()) @db.Uuid
  batchId          String          @db.Uuid
  actorId          String          @db.Uuid
  delta            Decimal         @db.Decimal(12, 3)
  reason           MovementReason
  note             String?
  listingId        String?         @db.Uuid
  offerId          String?         @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  batch            HarvestBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  actor            User            @relation("MovementActor", fields: [actorId], references: [id], onDelete: Restrict)
  ProduceListing   ProduceListing? @relation(fields: [produceListingId], references: [id])
  produceListingId String?         @db.Uuid

  @@index([batchId, createdAt])
}

model SensorReading {
  id                      String        @id @default(uuid()) @db.Uuid
  batchId                 String        @db.Uuid
  sensorId                String?       @db.Uuid
  storageUnitId           String?       @db.Uuid
  actorId                 String?       @db.Uuid
  recordedAt              DateTime      @db.Timestamptz(6)
  ingestedAt              DateTime      @default(now()) @db.Timestamptz(6)
  temperatureC            Decimal       @db.Decimal(6, 2)
  relativeHumidityPercent Decimal       @db.Decimal(5, 2)
  source                  ReadingSource
  metadata                Json?
  clientOperationId       String?       @db.VarChar(100)
  batch                   HarvestBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sensor                  Sensor?       @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  storageUnit             StorageUnit?  @relation(fields: [storageUnitId], references: [id], onDelete: SetNull)
  actor                   User?         @relation("ReadingActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([actorId, clientOperationId])
  @@index([batchId, recordedAt])
  @@index([sensorId, recordedAt])
}

model QualityObservation {
  id                String       @id @default(uuid()) @db.Uuid
  batchId           String       @db.Uuid
  observerId        String       @db.Uuid
  observedAt        DateTime     @db.Timestamptz(6)
  discardedQuantity Decimal      @default(0) @db.Decimal(12, 3)
  unit              Unit
  firmness          String       @db.VarChar(20)
  visibleMold       Boolean      @default(false)
  leakage           Boolean      @default(false)
  shriveling        Boolean      @default(false)
  qualityScore      Int?
  notes             String?
  clientOperationId String?      @db.VarChar(100)
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  batch             HarvestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  observer          User         @relation(fields: [observerId], references: [id], onDelete: Restrict)

  @@unique([observerId, clientOperationId])
  @@index([batchId, observedAt])
}

model PriceObservation {
  id                String   @id @default(uuid()) @db.Uuid
  cropId            String   @db.Uuid
  marketId          String   @db.Uuid
  enteredById       String   @db.Uuid
  amount            Decimal  @db.Decimal(14, 2)
  currency          String   @db.VarChar(3)
  unit              Unit
  observedAt        DateTime @db.Timestamptz(6)
  source            String   @db.VarChar(250)
  isDemo            Boolean  @default(false)
  clientOperationId String?  @db.VarChar(100)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  crop              Crop     @relation(fields: [cropId], references: [id], onDelete: Restrict)
  market            Market   @relation(fields: [marketId], references: [id], onDelete: Restrict)
  enteredBy         User     @relation("PriceEnteredBy", fields: [enteredById], references: [id], onDelete: Restrict)
  User              User?    @relation(fields: [userId], references: [id])
  userId            String?  @db.Uuid

  @@unique([enteredById, clientOperationId])
  @@index([cropId, marketId, observedAt])
}

model PriceAlertRule {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  cropId        String         @db.Uuid
  marketId      String         @db.Uuid
  targetAmount  Decimal        @db.Decimal(14, 2)
  currency      String         @db.VarChar(3)
  unit          Unit
  condition     AlertCondition
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  crop          Crop           @relation(fields: [cropId], references: [id], onDelete: Cascade)
  market        Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([cropId, marketId, active])
}

model ProduceListing {
  id                String              @id @default(uuid()) @db.Uuid
  ownerId           String              @db.Uuid
  batchId           String              @db.Uuid
  quantity          Decimal             @db.Decimal(12, 3)
  remainingQuantity Decimal             @db.Decimal(12, 3)
  unit              Unit
  askingPrice       Decimal?            @db.Decimal(14, 2)
  currency          String?             @db.VarChar(3)
  availableFrom     DateTime?           @db.Timestamptz(6)
  availableUntil    DateTime            @db.Timestamptz(6)
  collectionArea    String              @db.VarChar(180)
  contactPreference String              @default("IN_APP") @db.VarChar(32)
  contactConsent    Boolean             @default(false)
  status            ListingStatus       @default(ACTIVE)
  moderationNote    String?
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(6)
  owner             User                @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  batch             HarvestBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  offers            BuyerOffer[]
  movements         InventoryMovement[]
  reports           UserReport[]
  contactRequests   ContactRequest[]

  @@index([status, availableUntil])
  @@index([ownerId, status])
}

model BuyerOffer {
  id           String          @id @default(uuid()) @db.Uuid
  listingId    String          @db.Uuid
  buyerId      String          @db.Uuid
  quantity     Decimal         @db.Decimal(12, 3)
  unit         Unit
  offeredPrice Decimal?        @db.Decimal(14, 2)
  currency     String?         @db.VarChar(3)
  message      String?
  status       OfferStatus     @default(PENDING)
  version      Int             @default(1)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)
  confirmedAt  DateTime?       @db.Timestamptz(6)
  listing      ProduceListing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer        User            @relation("OfferBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  payments     PaymentIntent[]

  @@index([listingId, status, createdAt])
  @@index([buyerId, status])
}

model PaymentIntent {
  id                    String                 @id @default(uuid()) @db.Uuid
  publicReference       String                 @unique @default(uuid()) @db.VarChar(36)
  payerId               String                 @db.Uuid
  offerId               String                 @db.Uuid
  amountXaf             Int
  currency              String                 @default("XAF") @db.VarChar(3)
  provider              String                 @default("FAPSHI") @db.VarChar(24)
  providerMode          PaymentMode
  providerTransactionId String?                @unique @db.VarChar(120)
  checkoutUrl           String?                @db.VarChar(2048)
  idempotencyKey        String                 @db.VarChar(100)
  requestFingerprint    String                 @db.VarChar(64)
  status                PaymentStatus          @default(CREATED)
  safeFailureCode       String?                @db.VarChar(80)
  lastProviderCheckAt   DateTime?              @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  completedAt           DateTime?              @db.Timestamptz(6)
  payer                 User                   @relation(fields: [payerId], references: [id], onDelete: Restrict)
  offer                 BuyerOffer             @relation(fields: [offerId], references: [id], onDelete: Restrict)
  providerEvents        PaymentProviderEvent[]

  @@unique([payerId, idempotencyKey])
  @@index([payerId, createdAt])
  @@index([offerId, status])
}

model PaymentProviderEvent {
  id               String         @id @default(uuid()) @db.Uuid
  paymentId        String?        @db.Uuid
  provider         String         @default("FAPSHI") @db.VarChar(24)
  providerTransId  String         @db.VarChar(120)
  payloadStatus    PaymentStatus
  verifiedStatus   PaymentStatus?
  deduplicationKey String         @unique @db.VarChar(260)
  outcome          String         @db.VarChar(40)
  receivedAt       DateTime       @default(now()) @db.Timestamptz(6)
  processedAt      DateTime?      @db.Timestamptz(6)
  payment          PaymentIntent? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([providerTransId, receivedAt])
}

model Notification {
  id               String              @id @default(uuid()) @db.Uuid
  recipientId      String              @db.Uuid
  event            NotificationEvent
  payload          Json
  channel          NotificationChannel @default(IN_APP)
  deliveryStatus   DeliveryStatus      @default(PENDING)
  deduplicationKey String              @unique @db.VarChar(220)
  attempts         Int                 @default(0)
  safeError        String?
  readAt           DateTime?           @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(6)
  recipient        User                @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  alertRule        PriceAlertRule?     @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)
  alertRuleId      String?             @db.Uuid

  @@index([recipientId, readAt, createdAt])
  @@index([deliveryStatus, createdAt])
}

model ContactRequest {
  id          String               @id @default(uuid()) @db.Uuid
  listingId   String               @db.Uuid
  requesterId String               @db.Uuid
  message     String?              @db.VarChar(1000)
  status      ContactRequestStatus @default(REQUESTED)
  reviewedAt  DateTime?            @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  listing     ProduceListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requester   User                 @relation("ContactRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([listingId, requesterId])
}

model UserReport {
  id          String          @id @default(uuid()) @db.Uuid
  authorId    String          @db.Uuid
  listingId   String?         @db.Uuid
  subject     String          @db.VarChar(160)
  details     String          @db.VarChar(2000)
  status      ReportStatus    @default(OPEN)
  outcome     String?
  moderatorId String?         @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)
  author      User            @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  listing     ProduceListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  moderator   User?           @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model SyncOperation {
  id                String     @id @default(uuid()) @db.Uuid
  actorId           String     @db.Uuid
  clientOperationId String     @db.VarChar(100)
  entity            String     @db.VarChar(80)
  operation         String     @db.VarChar(40)
  requestHash       String     @db.Char(64)
  status            SyncStatus @default(PROCESSING)
  safeErrorCode     String?
  resultReference   String?
  result            Json?
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)
  actor             User       @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, clientOperationId])
  @@index([actorId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(80)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
