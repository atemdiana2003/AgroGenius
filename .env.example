NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://harvestguard:local-development-only@localhost:5432/harvestguard?schema=public
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=info
COOKIE_SECURE=false
SMS_PROVIDER=simulated
SMS_API_KEY=
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=mock
FAPSHI_MODE=sandbox
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=
DEVICE_TOKEN_PEPPER=replace-with-a-different-random-secret
RESET_TOKEN_TTL_MINUTES=30
TEMPERATURE_MIN_C=-10
TEMPERATURE_MAX_C=60
EXPERIMENTAL_TEMP_MIN_C=8
EXPERIMENTAL_TEMP_MAX_C=15
EXPERIMENTAL_RH_MIN_PERCENT=70
EXPERIMENTAL_RH_MAX_PERCENT=95
